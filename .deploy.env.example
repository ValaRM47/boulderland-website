# Copy this file to ".deploy.env" and fill in your real values.
# Get these from cPanel → "FTP Accounts" (create one if needed).
# Keep .deploy.env private — never commit or share it.

# The FTP server hostname (often your domain or an ftp. subdomain)
FTP_HOST=ftp.valarikhtegar.ir

# Your FTP username (cPanel usually shows it as user@valarikhtegar.ir)
FTP_USER=your_ftp_user@valarikhtegar.ir

# Your FTP password
FTP_PASS=your_ftp_password

# The folder the file should land in, as seen by FTP.
# For most cPanel hosts the wp-content folder is:
#   /public_html/wp-content
# If your FTP account already opens inside public_html, use just:
#   /wp-content
REMOTE_DIR=/public_html/wp-content

# Connection scheme + encryption. Leave as-is unless your host complains.
#   FTP_SCHEME = ftp   (explicit FTPS via AUTH TLS on port 21 — most common)
#   USE_TLS    = yes   (require encryption; set to "no" only if your host has no TLS)
FTP_SCHEME=ftp
USE_TLS=yes
